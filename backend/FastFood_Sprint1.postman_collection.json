				{
					"name": "Đăng nhập tài khoản (Lấy Token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Tự động lấy token từ kết quả trả về và lưu vào biến môi trường",
									"var jsonData = pm.response.json();",
									"if(jsonData.success && jsonData.data.token) {",
									"    pm.globals.set(\"jwt_token\", jsonData.data.token);",
									"}"
								],
								"type": "javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email_or_phone\": \"dinh@fastfood.com\",\n    \"mat_khau\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Đăng nhập để nhận Token JWT. (Mặc định tài khoản Đình là Admin có quyền chạy API Admin)."
					},
					"response": []
				},
