{
	"info": {
		"_postman_id": "c99d58e3-3333-4f39-8888-sprint3fastfood",
		"name": "FastFood App - Sprint 3",
		"description": "Bộ sưu tập API cho Sprint 3 (Sprint Cuối): Tùy biến Dinh dưỡng (Killer Feature), Mã giảm giá/Voucher và Thanh toán trực tuyến VietQR.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Authentication (Lấy Token xác thực)",
			"item": [
				{
					"name": "Đăng nhập Khách Hàng (Hoàng)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if(jsonData.success && jsonData.data.token) {",
									"    pm.globals.set(\"jwt_token\", jsonData.data.token);",
									"}"
								],
								"type": "javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email_or_phone\": \"hoang@fastfood.com\",\n    \"mat_khau\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Đăng nhập tài khoản khách hàng để tự động lưu Token JWT vào biến toàn cục {{jwt_token}}"
					},
					"response": []
				}
			]
		},
