						},
						"url": {
							"raw": "{{base_url}}/cart/add",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"cart",
								"add"
							]
						},
						"description": "Thêm 1 Pepsi Lon Size M (2)"
					},
					"response": []
				},
				{
					"name": "Cập nhật số lượng món trong giỏ",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "{{jwt_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"so_luong\": 3\n}"
