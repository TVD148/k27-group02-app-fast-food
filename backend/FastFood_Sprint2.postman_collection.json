						"description": "Thay số 1 ở đường dẫn bằng ma_chi_tiet_gio cần xóa"
					},
					"response": []
				},
				{
					"name": "Làm sạch (xóa toàn bộ) giỏ hàng",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "{{jwt_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/cart/clear",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"cart",
								"clear"
							]
						},
						"description": "Xóa toàn bộ các món trong giỏ hàng hiện tại"
					},
					"response": []
				}
			]
		},
		{
