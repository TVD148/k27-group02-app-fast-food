						"description": "Thay số 1 bằng mã chi tiết giỏ (ma_chi_tiet_gio) để thay đổi số lượng"
					},
					"response": []
				},
				{
					"name": "Xóa 1 món khỏi giỏ hàng",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "{{jwt_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/cart/remove/1",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"cart",
								"remove",
								"1"
							]
