{
	"info": {
		"_postman_id": "b88c47d2-1111-4e28-9999-sprint2fastfood",
		"name": "FastFood App - Sprint 2",
		"description": "Bộ sưu tập các API cho Sprint 2 bao gồm: Quản lý Giỏ hàng (Cart API), Tạo đơn hàng (Checkout), Cập nhật trạng thái đơn (Order Status Pipeline) và Theo dõi tiến trình (Order Tracking).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Authentication (Đăng nhập lấy Token)",
			"item": [
				{
					"name": "Đăng nhập Khách Hàng (Hoàng)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if(jsonData.success && jsonData.data.token) {",
									"    pm.globals.set(\"jwt_token\", jsonData.data.token);",
									"}"
								],
								"type": "javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email_or_phone\": \"hoang@fastfood.com\",\n    \"mat_khau\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Đăng nhập tài khoản khách hàng để lấy Token thử nghiệm Giỏ hàng và Tạo đơn"
					},
					"response": []
				},
				{
					"name": "Đăng nhập Nhân Viên Bếp (Lê Văn Bếp)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if(jsonData.success && jsonData.data.token) {",
									"    pm.globals.set(\"kitchen_jwt_token\", jsonData.data.token);",
									"}"
								],
								"type": "javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email_or_phone\": \"bep@fastfood.com\",\n    \"mat_khau\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Đăng nhập tài khoản Bếp để cập nhật trạng thái đơn sang 'dang_che_bien'"
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Cart API (Quản lý Giỏ Hàng)",
			"item": [
				{
					"name": "Lấy chi tiết Giỏ hàng",
					"request": {
						"method": "GET",
						"header": [
